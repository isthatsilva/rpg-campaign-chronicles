# copy to .env and fill in SESSION_SECRET (never commit .env)
# 5001 because macOS AirPlay Receiver already listens on 5000
PORT=5001
DATABASE_PATH=./data/app.db
# required, at least 16 characters. generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
SESSION_TTL_DAYS=7
# set to true when served over https
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
