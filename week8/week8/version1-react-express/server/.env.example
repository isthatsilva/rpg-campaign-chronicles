# port the api listens on (the vite dev server proxies /api here)
PORT=4000
# sqlite database file, relative to the server/ folder
DATABASE_PATH=./data/app.db
# long random string used to hmac session tokens before storing them.
# generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# how long a login lasts
SESSION_TTL_DAYS=7
# set to true when serving over https so the cookie is only sent securely
COOKIE_SECURE=false
# bcrypt cost factor (12 is a good default; tests use 4 for speed)
BCRYPT_ROUNDS=12
